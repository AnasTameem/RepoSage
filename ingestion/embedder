import sys
import time
from pathlib import Path
from typing import List, Dict, Any

sys.path.append(str(Path(__file__).resolve().parent.parent))

import voyageai
from config import EMBEDDING_MODEL_NAME, EMBEDDING_DIMENSION, BATCH_SIZE
from ingestion.node_preparer import RichNodePayload, NodePreparer

class VoyageBatchEmbedder:
    def __init__(
        self,
        model_name: str = EMBEDDING_MODEL_NAME,
        output_dimension: int = EMBEDDING_DIMENSION,
        batch_size: int = BATCH_SIZE
    ):
        self.model_name = model_name
        self.output_dimension = output_dimension
        self.batch_size = batch_size
        self.client = voyageai.Client()

    def generate_embeddings(self, payloads: List[RichNodePayload]) -> List[Dict[str, Any]]:
        embedded_records = []
        total_payloads = len(payloads)

        for i in range(0, total_payloads, self.batch_size):
            batch = payloads[i : i + self.batch_size]
            batch_texts = [p.formatted_payload for p in batch]
        
            try:
                # Voyage AI API Call for Code Documents
                response = self.client.embed(
                    texts=batch_texts,
                    model=self.model_name,
                    input_type="document",  # Explicitly set document context
                    output_dimension=self.output_dimension
                )

                embeddings = response.embeddings

                for payload, vector in zip(batch, embeddings):
                    embedded_records.append({
                        "node_id": payload.node_id,
                        "vector": vector,
                        "payload_text": payload.formatted_payload,
                        "metadata": payload.metadata
                    })

                batch_num = (i // self.batch_size) + 1
                total_batches = (total_payloads + self.batch_size - 1) // self.batch_size
                print(f"    [✓] Processed Batch {batch_num}/{total_batches} ({len(batch)} nodes)")

            except Exception as e:
                print(f"    [X] Error embedding batch starting at index {i}: {e}")
                raise e

            # Gentle rate-limiting sleep
            time.sleep(0.1)

        print(f"\n[✓] Successfully generated {len(embedded_records)} embeddings via {self.model_name}.")
        return embedded_records

if __name__ == "__main__":
    print("=" * 70)
    print("STAGE 3: VOYAGE CODE 3 BATCH EMBEDDING TEST")
    print("=" * 70)

    # 1. Prepare Stage 2 Payloads
    preparer = NodePreparer()
    payloads = preparer.process_repository()

    if not payloads:
        print("[X] No payloads returned from Stage 2.")
    else:
        # 2. Run Embedder
        embedder = VoyageBatchEmbedder()
        records = embedder.generate_embeddings(payloads)

        if records:
            sample = records[0]
            print("\n--- SAMPLE RECORD ---")
            print(f"Node ID          : {sample['node_id']}")
            print(f"Vector Dimensions: {len(sample['vector'])}")
            print(f"Sample Vector    : {sample['vector'][:5]}...")